---
import Layout from '@/layouts/Layout.astro'
import Avatar from '@/components/Base/Avatar.astro'
import Email from '@/components/Email.astro'
import Socials from '@/components/Socials.astro'
import Project from '@/components/Project.astro'
---

<Layout>
    <div class="flex flex-col items-start gap-4">
        <Avatar size={96} />

        <h2 class="text-xl text-zinc-600 dark:text-zinc-300">
            Heya! I'm{' '}
            <span class="font-medium text-zinc-800 dark:text-zinc-100">
                Alex
            </span>
            , though you might know me online as Naibuu. I'm a fullstack
            engineer with experience in both web and software development.
        </h2>

        <Socials />
    </div>

    <div class="flex flex-col gap-4">
        <h1 class="text-2xl font-medium text-zinc-800 dark:text-zinc-200">
            Building
        </h1>

        <Project
            icon="/assets/icons/cheatbreaker.png"
            name="CheatBreaker"
            description="The modpack for competitive versions of Minecraft."
            start={2023}
        />
    </div>

    <div class="flex flex-col gap-4">
        <h1 class="text-2xl font-medium text-zinc-800 dark:text-zinc-200">
            Previously
        </h1>

        <Project
            icon="/assets/icons/cheatbreaker.png"
            name="CheatBreaker"
            description="The modpack for competitive versions of Minecraft."
            start={2023}
            end={2030}
        />
    </div>
</Layout>
