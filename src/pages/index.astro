---
import Layout from '@/layouts/Layout.astro'
import Avatar from '@/components/Base/Avatar.astro'
import Email from '@/components/Email.astro'
import Socials from '@/components/Socials.astro'
---

<Layout>
    <div class="flex flex-col items-start gap-4">
        <Avatar size={96} />

        <h2 class="text-xl font-medium text-zinc-600 dark:text-zinc-300">
            Heya! I'm <span class="text-zinc-700 dark:text-zinc-100">Alex</span>
            , though you might know me online as Naibuu. I'm a fullstack
            engineer with experience in both web and software development.
        </h2>

        <Socials />
    </div>

    <Email />
</Layout>
