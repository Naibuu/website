---
import { Icon } from 'astro-icon/components'
import Box from './Base/Box.astro'
---

<Box>
    <h2 class="text-xl font-medium text-zinc-600 dark:text-zinc-300">
        <Icon name="ph:mailbox-fill" class="inline" /> Let's talk!
    </h2>

    <p class="text-lg text-zinc-500 dark:text-zinc-400">
        Need help bringing an idea to life? Reach out via email and let's
        discuss what we can build together.
    </p>

    <span class="mt-1 flex items-center text-lg dark:text-zinc-300 text-zinc-600">
        me@naibuu.dev
    </span>
</Box>
