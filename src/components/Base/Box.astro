---
interface Props {
    parentClass?: string
    row?: boolean
}

const { parentClass, row = false } = Astro.props
---

<div
    class:list={[
        'flex border border-zinc-300 bg-zinc-100 px-8 py-6 dark:border-zinc-800 dark:bg-zinc-900',
        parentClass,
        {
            'flex-col': !row,
        },
    ]}
>
    <slot />
</div>
