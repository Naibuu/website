---
import { Metadata } from '@/consts'
import { Image } from 'astro:assets'

interface Props {
    size: number
}

const { size } = Astro.props
---

<Image
    src="/assets/profile.png"
    alt={Metadata.title}
    class="rounded-full shrink-0 shadow select-none"
    width={size}
    height={size}
    draggable={false}
    loading="eager"
/>
