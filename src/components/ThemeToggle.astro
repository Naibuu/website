---
import { Icon } from 'astro-icon/components'
---

<button
    id="theme-toggle"
    class="flex size-12 cursor-pointer items-center justify-center transition text-neutral-600 hover:opacity-80 active:scale-95 dark:text-neutral-200"
>
    <Icon name="ph:sun-duotone" size={18} class="hidden dark:block" />
    <Icon name="ph:moon-duotone" size={18} class="block dark:hidden" />
</button>

<script>
    import { type Theme, getTheme, setTheme } from '@/utils/theme'
    import { onClick, setRootAttribute } from '@/utils/dom'

    function toggleTheme(): void {
        const current = getTheme()
        const newTheme: Theme = current === 'dark' ? 'light' : 'dark'
        setTheme(newTheme)
        setRootAttribute('data-theme', newTheme)
    }

    setRootAttribute('data-theme', getTheme())

    onClick<HTMLButtonElement>('theme-toggle', () => {
        toggleTheme()
    })
</script>
